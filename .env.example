# מפתח שליחה מ-web3forms.com (חינמי) - נדרש כדי שטופס יצירת הקשר בעמוד הבית ישלח מיילים בפועל
# איך משיגים אותו: https://web3forms.com/ -> מזינים את המייל שאליו רוצים לקבל פניות -> "Create Access Key"
NEXT_PUBLIC_WEB3FORMS_KEY=

# מזהה Measurement ID מ-Google Analytics (GA4) - נדרש לסטטיסטיקת ביקורים
# איך משיגים אותו: https://analytics.google.com/ -> Admin -> Data Streams -> ה-stream שלכם
NEXT_PUBLIC_GA_ID=
