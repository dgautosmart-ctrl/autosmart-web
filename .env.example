# מפתח API מ-resend.com - נדרש כדי שהטפסים באתר ישלחו מיילים (התראה לעסק + אישור אוטומטי לפונה)
# איך משיגים: https://resend.com -> API Keys -> Create
RESEND_API_KEY=

# כתובת השולח של המיילים - חייבת להיות בדומיין מאומת ב-Resend
# למשל: AutoSmart <hello@autosmartbiz.co.il>
LEAD_MAIL_FROM=

# מזהה Measurement ID מ-Google Analytics (GA4) - נדרש לסטטיסטיקת ביקורים
# איך משיגים אותו: https://analytics.google.com/ -> Admin -> Data Streams -> ה-stream שלכם
NEXT_PUBLIC_GA_ID=
